{
  "expo": {
    "name": "Akbar's Academy",
    "slug": "akbars-academy",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "akbars",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.akbarsacademy.app"
    },
    "android": {
      "package": "in.akbarsacademy.app",
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "themeColor": "#104E82",
      "description": "Akbar's Academy — fingerprint attendance, registers and parent alerts.",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "akbarsacademy98s-team",
    "extra": {
      "eas": {
        "projectId": "83531652-1a4e-48da-935f-f469b70538d0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/83531652-1a4e-48da-935f-f469b70538d0"
    },
    "icon": "./assets/icon.png"
  }
}
